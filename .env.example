# Copia este archivo a .env.local y rellena los valores.
# Nunca confirmes .env.local en el repositorio.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera_un_secreto_largo_con_openssl_rand_base64_32

# --- Supabase (también aceptadas: PROJECT_URL_SUPABASE, ANON_PUBLIC_SUPABASE, SERVICE_ROLE_SUPABASE) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google OAuth (login + Sheets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: en desarrollo, trazas detalladas (p. ej. JSON de IA). También NEXT_PUBLIC_LOG_VERBOSE para cliente.
# LOG_VERBOSE=1

# --- URLs de la app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheets sin OAuth: API key del proyecto donde está habilitada "Google Sheets API".
# Preferible servidor: GOOGLE_API_KEY=... También admite NEXT_PUBLIC_GOOGLE_API_KEY (menos recomendado).
# GOOGLE_API_KEY=
# NEXT_PUBLIC_GOOGLE_API_KEY=

# --- Script npm run clear-dev-data (Postgres directo; p. ej. cadena de Supabase) ---
# DIRECT_DATABASE_URL=postgresql://postgres.xxx:...@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Login demo (solo desarrollo / pruebas; desactivado por defecto) ---
# AUTH_DEMO_LOGIN_ENABLED=true
# AUTH_DEMO_USER_EMAIL=demo@example.com
# AUTH_DEMO_USER_PASSWORD=cambia_esto
# AUTH_DEMO_USER_ID=cmodqsemt000104lbmwixnsed
